{
  "experiment_id": "wdc_train_test_ratio_grid_protocol_v1",
  "status": "protocol_locked_no_fit",
  "purpose": "Plan a full train-ratio by test-ratio grid without model fitting.",
  "dataset_config": "configs/datasets/wdc_products_80pair.json",
  "model_config": "configs/models/baseline_traditional.json",
  "processed_root": "data/processed",
  "results_root": "results",
  "splits": {
    "train": "train_small",
    "validation": "valid_small",
    "test": "test_unseen_100un"
  },
  "development_to_test_guards": {
    "require_pair_disjoint": true,
    "require_record_disjoint": true,
    "require_entity_disjoint": true
  },
  "train_validation_guards": {
    "require_pair_disjoint": true,
    "require_record_disjoint": true,
    "require_entity_disjoint": false,
    "known_entity_overlap_allowed": true,
    "known_entity_overlap_reason": "The official WDC train_small and valid_small splits have entity overlap. Validation may be used for threshold selection, but this run must not claim train-validation entity disjointness."
  },
  "threshold_selection": {
    "split_role": "validation",
    "selection_metric": "f1",
    "candidate_thresholds": {
      "start": 0.0,
      "end": 1.0,
      "step": 0.01
    }
  },
  "final_test_policy": {
    "test_split_role": "test",
    "use_test_for_threshold_selection": false,
    "use_test_for_model_selection": false,
    "report_test_once_per_seed": true
  },
  "train_test_ratio_grid": {
    "positive_label": 1,
    "negative_label": 0,
    "train_positive_policy": "use_all_available_positives",
    "test_positive_policy": "use_all_available_positives",
    "train_negative_per_positive_values": [1, 2, 3, 4],
    "test_negative_per_positive_values": [1, 2, 3, 4],
    "train_negative_sampling": {
      "without_replacement": true,
      "seeded_by": "experiment_seed",
      "sampling_unit": "training_pair",
      "write_sampled_tables_now": false
    },
    "test_negative_sampling": {
      "without_replacement": true,
      "seeded_by": "experiment_seed",
      "sampling_unit": "test_pair",
      "write_sampled_tables_now": false
    }
  },
  "random_seeds": [13, 29, 47, 71, 101],
  "planned_models": ["logistic_regression", "random_forest", "svm"],
  "fit_allowed": false,
  "fit_blockers": [
    "Full train/test ratio grid training requires explicit user approval."
  ],
  "notes": "This protocol crosses train ratios {1:1, 1:2, 1:3, 1:4} with test ratios {1:1, 1:2, 1:3, 1:4}. It plans 60 model fits and 240 test evaluations if later approved."
}
