{
  "experiment_id": "wdc_class_ratio_stress_protocol_v1",
  "status": "protocol_locked_no_fit",
  "source_protocol_config": "configs/experiments/wdc_unseen_baseline_protocol.json",
  "purpose": "Plan a class-ratio stress test under the locked WDC unseen protocol without fitting models.",
  "dataset_config": "configs/datasets/wdc_products_80pair.json",
  "model_config": "configs/models/baseline_traditional.json",
  "processed_root": "data/processed",
  "results_root": "results",
  "splits": {
    "train": "train_small",
    "validation": "valid_small",
    "test": "test_unseen_100un"
  },
  "development_to_test_guards": {
    "require_pair_disjoint": true,
    "require_record_disjoint": true,
    "require_entity_disjoint": true
  },
  "train_validation_guards": {
    "require_pair_disjoint": true,
    "require_record_disjoint": true,
    "require_entity_disjoint": false,
    "known_entity_overlap_allowed": true,
    "known_entity_overlap_reason": "The official WDC train_small and valid_small splits have entity overlap. Validation may be used for threshold selection, but this protocol must not claim train-validation entity disjointness."
  },
  "threshold_selection": {
    "split_role": "validation",
    "selection_metric": "f1",
    "candidate_thresholds": {
      "start": 0.0,
      "end": 1.0,
      "step": 0.01
    }
  },
  "final_test_policy": {
    "test_split_role": "test",
    "use_test_for_threshold_selection": false,
    "use_test_for_model_selection": false,
    "report_test_once_per_seed": true
  },
  "class_ratio_stress_test": {
    "positive_label": 1,
    "negative_label": 0,
    "train_positive_policy": "use_all_available_positives",
    "negative_per_positive_values": [1, 2, 3, 4],
    "negative_sampling": {
      "without_replacement": true,
      "seeded_by": "experiment_seed",
      "sampling_unit": "training_pair",
      "write_sampled_tables_now": false
    },
    "fixed_evaluation_splits": ["validation", "test"]
  },
  "random_seeds": [13, 29, 47, 71, 101],
  "planned_models": ["logistic_regression", "random_forest", "svm"],
  "fit_allowed": false,
  "fit_blockers": [
    "This config locks the class-ratio stress-test plan only.",
    "No sampled training tables are written by the preview step.",
    "No model fitting is approved for this class-ratio experiment yet."
  ],
  "notes": "Training class ratio changes only the training split. Validation and test remain fixed so differences can be attributed to training class-ratio changes rather than evaluation-set changes."
}
